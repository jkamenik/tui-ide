.DS_Store
.gitconfig.local
*.local
obsidian-local.lua

# Personal opencode config for this repo. opencode's filename is fixed, so the
# *.local convention above cannot apply; ignore the real names at the root only,
# so a tracked opencode.json in a nested project is unaffected.
/opencode.json
/opencode.jsonc

# Aikido endpoint protection rewrites the stowed ~/.zshrc in place and leaves a
# backup next to it, i.e. inside the repo.
*.aikido-backup

# herdr runtime state (rewritten in place, replaces stow links)
dotfiles/herdr/.config/herdr/.plugins.lock
dotfiles/herdr/.config/herdr/herdr-client.log
dotfiles/herdr/.config/herdr/herdr-client.sock
dotfiles/herdr/.config/herdr/herdr.sock
dotfiles/herdr/.config/herdr/session.json
