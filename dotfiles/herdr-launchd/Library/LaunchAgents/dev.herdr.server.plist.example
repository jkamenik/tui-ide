<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Machine-specific herdr server LaunchAgent. install.sh renders this from the
  example (git-ignored local copy at ~/.config/herdr-launchd/). Running the
  server under launchd keeps it out of the terminal app's LaunchServices
  coalition, so quitting iTerm2 no longer force-quits the herdr server.
  Placeholders:
    __HERDR_BIN__ -> absolute path of the herdr binary
    __HOME__      -> home directory
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.herdr.server</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HERDR_BIN__</string>
		<string>server</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HERDR_MACOS_SERVER_CONTEXT</key>
		<string>user</string>
	</dict>
	<key>WorkingDirectory</key>
	<string>__HOME__</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<false/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>__HOME__/.config/herdr/launchd-stdout.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/.config/herdr/launchd-stderr.log</string>
</dict>
</plist>