# Shared git config for all machines. Machine-specific identity and signing
# live in ~/.gitconfig.local (not tracked; see .gitconfig.local.example).
[include]
	path = ~/.gitconfig.local

[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process

[user]
	name = John Kamenik

[gpg]
	format = ssh

[commit]
	gpgsign = true
