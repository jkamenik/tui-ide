#!/usr/bin/env bash
#
# git-workspace <branch> [base] [--no-focus] [--path <dir>]
#
# Create and open a Git worktree-backed workspace, integrated with Herdr and
# OpenCode.
#
# If the worktree or branch already exists, it brings it into focus or opens it
# in Herdr without creating a duplicate. If Herdr is running, the workspace appears
# in Herdr's sidebar. If OpenCode is running, OpenCode's worktree inventory is
# refreshed so the new worktree is immediately available in the picker.
#
# On $PATH as `git-workspace`, Git also exposes it as the subcommand
# `git workspace <branch> [base]`.
#
set -euo pipefail

# Keep git from opening a pager
export GIT_PAGER=cat
unset PAGER

die() { echo "git-workspace: $*" >&2; exit 1; }
info() { echo "==> $*"; }

usage() {
  cat <<'EOF'
Usage: git-workspace <branch> [base] [options]
       git workspace <branch> [base] [options]

Arguments:
  branch              Name of the branch/worktree to create or open
  base                Base commit or branch to start from (defaults to default branch)

Options:
  --no-focus          Do not switch focus to the new workspace in Herdr
  --path <dir>        Explicit checkout directory for the worktree
  -h, --help          Show this help
EOF
  exit 0
}

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not a git repository"

branch=""
base=""
custom_path=""
focus_flag="--focus"

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      ;;
    --no-focus)
      focus_flag="--no-focus"
      shift
      ;;
    --path)
      [ $# -ge 2 ] || die "--path requires a directory argument"
      custom_path="$2"
      shift 2
      ;;
    *)
      if [ -z "$branch" ]; then
        branch="$1"
      elif [ -z "$base" ]; then
        base="$1"
      else
        die "unexpected argument: $1"
      fi
      shift
      ;;
  esac
done

[ -n "$branch" ] || die "branch name is required. Usage: git workspace <branch> [base]"

# Find the primary repository checkout root
common_dir="$(git rev-parse --git-common-dir)"
repo_root="$(cd "$common_dir/.." && pwd)"
repo_name="$(basename "$repo_root")"

# Resolve base branch if not provided
if [ -z "$base" ]; then
  base="$(git -C "$repo_root" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
  base="${base#origin/}"
fi
if [ -z "$base" ]; then
  for candidate in main master; do
    if git -C "$repo_root" show-ref --verify --quiet "refs/heads/$candidate"; then
      base="$candidate"
      break
    fi
  done
fi
[ -n "$base" ] || base="HEAD"

# Refresh remote base if remote exists
if git -C "$repo_root" remote get-url origin >/dev/null 2>&1; then
  git -C "$repo_root" fetch --quiet origin "$base" 2>/dev/null || git -C "$repo_root" fetch --quiet origin 2>/dev/null || true
fi

# Notify OpenCode to refresh its cached worktrees for this project
notify_opencode() {
  local root="$1"
  if command -v opencode >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    local project_id
    project_id="$(opencode api get /api/project 2>/dev/null | jq -r --arg r "$root" '.[]? | select(.canonical == $r) | .id' 2>/dev/null || true)"
    if [ -n "$project_id" ]; then
      opencode api post /api/worktree/refresh --data "{\"projectID\":\"$project_id\"}" >/dev/null 2>&1 || true
    fi
  fi
}

# Check if worktree already exists in git
existing_path=""
while IFS= read -r line || [ -n "$line" ]; do
  if [[ "$line" =~ ^worktree\ (.*)$ ]]; then
    curr_wt="${BASH_REMATCH[1]}"
  elif [[ "$line" =~ ^branch\ refs/heads/(.*)$ ]]; then
    curr_b="${BASH_REMATCH[1]}"
    if [ "$curr_b" = "$branch" ]; then
      existing_path="$curr_wt"
      break
    fi
  fi
done < <(git -C "$repo_root" worktree list --porcelain)

wt_path=""

if [ -n "$existing_path" ]; then
  info "Worktree for branch '$branch' already exists at $existing_path"
  wt_path="$existing_path"

  if command -v herdr >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    ws_id="$(herdr worktree list --cwd "$repo_root" 2>/dev/null \
      | jq -r --arg p "$existing_path" '.result.worktrees[]? | select(.path == $p and .open_workspace_id != null) | .open_workspace_id' 2>/dev/null || true)"
    if [ -n "$ws_id" ]; then
      if [ "$focus_flag" = "--focus" ]; then
        info "Focusing existing Herdr workspace ($ws_id)"
        herdr workspace focus "$ws_id" >/dev/null 2>&1 || true
      fi
    else
      info "Opening in Herdr"
      herdr worktree open --cwd "$repo_root" --branch "$branch" "$focus_flag" >/dev/null 2>&1 || true
    fi
  fi
else
  info "Creating worktree for '$branch' from '$base'"
  
  if command -v herdr >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    herdr_args=(worktree create --cwd "$repo_root" --branch "$branch" --base "$base" "$focus_flag")
    if [ -n "$custom_path" ]; then
      herdr_args+=(--path "$custom_path")
    fi

    create_out="$(herdr "${herdr_args[@]}" 2>/dev/null || true)"
    if [ -n "$create_out" ]; then
      wt_path="$(echo "$create_out" | jq -r '.result.worktree.path // .result.workspace.worktree.checkout_path // empty' 2>/dev/null || true)"
    fi
  fi

  # Fallback to direct git worktree add if Herdr didn't create it
  if [ -z "$wt_path" ] || [ ! -d "$wt_path" ]; then
    if [ -n "$custom_path" ]; then
      wt_path="$custom_path"
    else
      wt_path="${HOME}/.herdr/worktrees/${repo_name}/${branch}"
    fi

    mkdir -p "$(dirname "$wt_path")"
    if git -C "$repo_root" show-ref --verify --quiet "refs/heads/$branch"; then
      git -C "$repo_root" worktree add "$wt_path" "$branch"
    else
      git -C "$repo_root" worktree add -b "$branch" "$wt_path" "$base"
    fi

    # Try opening in Herdr if herdr is installed
    if command -v herdr >/dev/null 2>&1; then
      herdr worktree open --cwd "$repo_root" --path "$wt_path" "$focus_flag" >/dev/null 2>&1 || true
    fi
  fi
fi

notify_opencode "$repo_root"

info "Ready: $wt_path"
echo "$wt_path"
